# Deployment settings for MarkSync
# Copy to .env and adjust values.

# JWT lifetime (7d, 30d, 1h etc.)
JWT_EXPIRES_IN=7d

# Whether to allow public registration after the first admin is created.
# false = only the first user can register (recommended for personal use).
REGISTRATION_OPEN=false

# Comma-separated allowed CORS origins.
# Include your public dashboard URL and any chrome-extension:// entries you use.
CORS_ORIGINS=https://bookmark.zcoolq.cn,chrome-extension://

# Log level: debug | info | warn | error
LOG_LEVEL=info
