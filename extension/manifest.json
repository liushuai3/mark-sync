{
  "manifest_version": 3,
  "name": "MarkSync 书签同步",
  "version": "1.1.0",
  "description": "在不同设备间同步浏览器书签，支持 Gitee Gist 和自建后端双模式",
  "permissions": [
    "bookmarks",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://gitee.com/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup/options.html",
    "open_in_tab": false
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["docs/README.md", "popup/sync-record.html", "popup/popup.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
